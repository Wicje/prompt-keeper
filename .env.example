# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Supabase "service_role" key used by the Telegram webhook and
# external capture endpoint. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Telegram bot token from @BotFather (empty)
# https://t.me/botfather -> /newbot
TELEGRAM_BOT_TOKEN=

# Server-only. Optional shared secret that Telegram signs webhook calls with.
TELEGRAM_WEBHOOK_SECRET=
